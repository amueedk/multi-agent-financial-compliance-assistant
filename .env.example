# ── LLM Provider ──────────────────────────────────────────────────────────────
# "ollama" = local-first default for offline testing and development
# "gemini" = optional Google Gemini API testing path (needs GOOGLE_API_KEY below)
LLM_PROVIDER=ollama

# ── Ollama / Local LLM Configuration ──────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Alternative: llama3.2:3b
OLLAMA_TEMPERATURE=0.3

# ── Gemini / Cloud LLM Configuration ──────────────────────────────────────────
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
# Alternative (stronger, slower): gemini-2.5-pro

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── RAG Settings ──────────────────────────────────────────────────────────────
RAG_TOP_K=4
MAX_ITERATIONS=3

# ── FastAPI Dashboard ─────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Webhook (Simulated AWS Serverless) ────────────────────────────────────────
WEBHOOK_URL=http://localhost:9000/webhook
WEBHOOK_ENABLED=false

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
